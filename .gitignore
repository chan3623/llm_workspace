cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*.pyc

# 가상환경 (uv, venv)
.venv/
.venv-*/
venv/

data/

# uv
.python-version

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# VS Code
.vscode/

# 환경변수 / 민감정보
.env
.env.local

# 데이터 파일 (용량 크거나 민감할 수 있음)
*.csv
*.txt
data/

# 로그 / 출력물
*.log
newfile*.csv
newfile*.txt

# 모델 파일 (용량 큼)
*.joblib
*.pkl
*.h5
*.pt
*.pth
EOF

